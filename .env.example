# Copy to .env and fill in. Never commit .env.
#
# There is no local infrastructure to start. Development runs against the same
# hosted services production does — a MongoDB Atlas cluster and a LiveKit Cloud
# project — so what works on your machine is what works deployed.

# ---------------------------------------------------------------- database ---
# A MongoDB Atlas connection string, which looks like
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/us_stream?retryWrites=true&w=majority
#
# Two things matter in that string. The database name in the path — without it
# everything lands in "test". And, if you use the older multi-host form rather
# than mongodb+srv, `replicaSet=<name>`: without it the driver rediscovers the
# topology on every blip and can settle into ReplicaSetNoPrimary.
MONGODB_URI=

# ----------------------------------------------------------------- livekit ---
# LiveKit Cloud project credentials (wss://<project>.livekit.cloud).
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -------------------------------------------------------------- better auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------ public ---
# Printed on the privacy policy and the terms, and submitted to Google's OAuth
# consent screen. It ends up on a public page, so use an address you are happy
# to publish rather than a personal one.
NEXT_PUBLIC_CONTACT_EMAIL=

# ------------------------------------------------------------ guest access ---
# Signs short-lived identities for people who join by link without an account.
# Generate with: openssl rand -base64 32
GUEST_TOKEN_SECRET=

# ---------------------------------------------------------------- realtime ---
# The Fastify service on Railway: Yjs sync, LiveKit webhooks, meeting close-out.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001
REALTIME_PORT=3001
# Shared secret for server-to-server calls between web and realtime.
REALTIME_INTERNAL_SECRET=

# ------------------------------------------------------------------ deploy ---
# URL that starts a Vercel build when something POSTs to it, used by `pnpm deploy`.
#
# Pushing already deploys both services — Vercel via its Git integration,
# Railway via its GitHub-connected service — so this is only for rebuilding what
# is already on the remote (after changing a variable, or to retry a build that
# failed for a reason that has since gone away). Railway has no separate hook
# URL for this: use `railway redeploy` instead.
#   Vercel: Settings > Git > Deploy Hooks > Create
# Anyone holding this can spend your build minutes. Treat it as a secret.
VERCEL_DEPLOY_HOOK_URL=

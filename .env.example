# Copy to .env and fill in. Never commit .env.
# Local development values below match docker-compose.yml.

# ---------------------------------------------------------------- database ---
# MongoDB. Local: the docker-compose service below.
# Hosted: a MongoDB Atlas connection string, which looks like
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/us_stream?retryWrites=true&w=majority
# The database name in the path matters — without it everything lands in "test".
MONGODB_URI=mongodb://localhost:27017/us_stream

# ------------------------------------------------------------------- redis ---
# Only needed from phase 5 (Yjs pub/sub between realtime replicas).
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------- livekit ---
# Local: docker compose runs livekit-server in --dev mode with devkey/secret.
# Production: LiveKit Cloud project credentials (wss://<project>.livekit.cloud).
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# -------------------------------------------------------------- better auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------ public ---
# Printed on the privacy policy and the terms, and submitted to Google's OAuth
# consent screen. It ends up on a public page, so use an address you are happy
# to publish rather than a personal one.
NEXT_PUBLIC_CONTACT_EMAIL=

# ------------------------------------------------------------ guest access ---
# Signs short-lived identities for people who join by link without an account.
# Generate with: openssl rand -base64 32
GUEST_TOKEN_SECRET=

# ---------------------------------------------------------------- realtime ---
# The Fastify service on Railway: Yjs sync, LiveKit webhooks, breakout timers.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001
REALTIME_PORT=3001
# Shared secret for server-to-server calls between web and realtime.
REALTIME_INTERNAL_SECRET=

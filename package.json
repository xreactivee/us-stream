{
  "name": "us-stream",
  "version": "0.1.0",
  "private": true,
  "description": "us-stream \u2014 self-hosted video conferencing: rooms, video, audio, screen sharing, chat, whiteboard and polls.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:check": "pnpm --filter @us-stream/db db:check",
    "db:indexes": "pnpm --filter @us-stream/db db:indexes",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "typescript": "^5.9.3"
  }
}
